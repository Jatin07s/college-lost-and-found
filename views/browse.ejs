<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Reports — CampusFind</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('partials/navbar', { activePage: 'browse' }) %>

  <!-- Main Content Container -->
  <main class="main-content">
    <div class="container">

      <!-- Page Header -->
      <div class="section-heading" style="text-align: left; margin-bottom: 1.75rem;">
        <h2>Browse Campus Reports</h2>
        <p>Explore all active lost and found reports submitted by students.</p>
      </div>

      <!-- Search and Filter Bar -->
      <div class="browse-filter-bar">
        <!-- Search Input -->
        <div class="search-input-group">
          <input 
            type="text" 
            id="search-input" 
            class="form-control" 
            placeholder="Search by item name or keywords (e.g. bottle, calculator)..."
            value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
          >
        </div>

        <!-- Filter Controls -->
        <div class="filter-group">
          <button type="button" class="filter-btn type-filter-btn active" data-type="ALL">
            All Items
          </button>
          <button type="button" class="filter-btn type-filter-btn" data-type="LOST">
            Lost Only
          </button>
          <button type="button" class="filter-btn type-filter-btn" data-type="FOUND">
            Found Only
          </button>

          <!-- Category Dropdown Filter -->
          <select id="category-filter" class="form-control" style="width: auto; padding: 0.5rem 0.85rem; font-size: 0.85rem;">
            <option value="ALL">All Categories</option>
            <option value="Bottle">Bottle</option>
            <option value="Electronics">Electronics</option>
            <option value="Cards & IDs">Cards & IDs</option>
            <option value="Books & Notes">Books & Notes</option>
            <option value="Keys">Keys</option>
            <option value="Bags">Bags</option>
            <option value="Clothing">Clothing</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>

      <!-- Reports Grid -->
      <% if (typeof reports !== 'undefined' && reports.length > 0) { %>
        <div class="items-grid" id="reports-grid">
          <% reports.forEach(item => { %>
            <div 
              class="item-card" 
              data-type="<%= item.type %>" 
              data-title="<%= item.title.toLowerCase() %>" 
              data-category="<%= item.category %>"
              data-desc="<%= (item.description || '').toLowerCase() %>"
            >
              <div class="item-card-header">
                <h3 class="item-card-title"><%= item.title %></h3>
                <span class="badge <%= item.type === 'LOST' ? 'badge-lost' : 'badge-found' %>">
                  <%= item.type %>
                </span>
              </div>

              <div class="item-card-meta">
                <div class="meta-row">
                  <span class="meta-label">Category:</span>
                  <span><%= item.category %></span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Location:</span>
                  <span><%= item.location %></span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Color:</span>
                  <span><%= item.color %></span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Date:</span>
                  <span><%= new Date(item.itemDate).toLocaleDateString('en-GB') %></span>
                </div>
              </div>

              <p class="item-card-desc"><%= item.description || 'No additional details provided.' %></p>

              <div class="item-card-footer">
                <a href="/reports/<%= item.id %>" class="btn btn-outline btn-sm">
                  View Details
                </a>
                <a href="/matches/<%= item.id %>" class="btn btn-primary btn-sm">
                  Find Matches
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Dynamic / Empty Search State -->
      <div 
        id="no-results-state" 
        class="empty-state" 
        style="<%= typeof reports !== 'undefined' && reports.length > 0 ? 'display: none;' : 'display: block;' %>"
      >
        <div class="empty-state-icon">🔍</div>
        <h3>No Matching Reports Found</h3>
        <p>Try searching with different keywords or clear the category filters.</p>
        <div style="display: flex; justify-content: center; gap: 1rem;">
          <a href="/lost" class="btn btn-lost btn-sm">Report a Lost Item</a>
          <a href="/found" class="btn btn-found btn-sm">Report a Found Item</a>
        </div>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>

</body>
</html>
